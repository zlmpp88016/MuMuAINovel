# Book Analyzer 独立系统配置示例
# 复制为 `.env` 后按本机环境修改；空值表示不启用对应外部服务。

# 禁用规则分析
BOOK_ANALYZER_DISABLE_RULE_ANALYSIS=false


# 元数据数据库地址。默认使用独立 SQLite 文件；生产环境可改成 PostgreSQL 等 SQLAlchemy URL。
# SQLite 相对路径会按 book-analyzer/ 根目录解析。
BOOK_ANALYZER_DATABASE_URL=sqlite:///data/book_analyzer.db

# 运行时数据根目录。相对路径会按 book-analyzer/ 根目录解析。
BOOK_ANALYZER_DATA_DIR=data

# 上传 TXT 备份目录。一般保持默认即可。
BOOK_ANALYZER_UPLOADS_DIR=data/uploads

# JSON 导出目录。一般保持默认即可。
BOOK_ANALYZER_EXPORTS_DIR=data/exports

# 单个上传 TXT 文件的最大字节数。默认 52428800 = 50MB。
BOOK_ANALYZER_MAX_UPLOAD_BYTES=52428800

# 文本切块大小，单位为字符。越大上下文越完整，越小分析和检索越细。
BOOK_ANALYZER_CHUNK_SIZE=2000

# 相邻 chunk 的重叠字符数，用于减少切分边界造成的信息丢失；必须小于 CHUNK_SIZE。
BOOK_ANALYZER_CHUNK_OVERLAP=200

# 分析后端：auto=有主模型就用 LLM，否则规则；llm=强制主模型；rule=只用规则。
BOOK_ANALYZER_ANALYSIS_BACKEND=auto

# 向量库后端：auto=优先 Chroma，失败回退简单内存检索；chroma=强制 Chroma；simple=简单内存检索。
BOOK_ANALYZER_VECTOR_BACKEND=auto

# ChromaDB 持久化目录。默认写入 book-analyzer/data/chroma。
BOOK_ANALYZER_CHROMA_DIR=data/chroma

# Chroma collection 名称。留空时按 embedding 维度自动生成，例如 ba_corpus_dim384。
BOOK_ANALYZER_CHROMA_COLLECTION_NAME=

# 主分析模型提供方，用于 chunk 摘要和整书汇总。支持 openai 或 anthropic。
BOOK_ANALYZER_DEFAULT_AI_PROVIDER=openai

# 主分析模型名称。OpenAI-compatible 服务可填写对应模型名。
BOOK_ANALYZER_DEFAULT_MODEL=gpt-4o-mini

# 主分析模型温度。越低越稳定，越高越发散。
BOOK_ANALYZER_DEFAULT_TEMPERATURE=0.7

# 主分析模型最大输出 token 数。
BOOK_ANALYZER_DEFAULT_MAX_TOKENS=2000

# OpenAI 或 OpenAI-compatible API key；DEFAULT_AI_PROVIDER=openai 时使用。
BOOK_ANALYZER_OPENAI_API_KEY=

# OpenAI 或 OpenAI-compatible base URL；接第三方兼容服务时改这里。
BOOK_ANALYZER_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API key；DEFAULT_AI_PROVIDER=anthropic 时使用。
BOOK_ANALYZER_ANTHROPIC_API_KEY=

# Anthropic base URL；通常留空，私有代理或兼容网关才需要配置。
BOOK_ANALYZER_ANTHROPIC_BASE_URL=

# 段落打标签后端：auto=有专用小模型就用，否则规则；llm=强制小模型；rule=只用规则。
BOOK_ANALYZER_TAGGING_BACKEND=auto

# 段落打标签模型提供方。建议接成本更低的小模型或本地 OpenAI-compatible 服务。
BOOK_ANALYZER_TAGGING_AI_PROVIDER=openai

# 段落打标签模型名称。专门用于 tags、scene_type、mood、characters 等轻量分类。
BOOK_ANALYZER_TAGGING_MODEL=gpt-4o-mini

# 段落打标签模型温度。建议保持较低，保证标签稳定。
BOOK_ANALYZER_TAGGING_TEMPERATURE=0.1

# 段落打标签模型最大输出 token 数。标签 JSON 较短，通常不需要很大。
BOOK_ANALYZER_TAGGING_MAX_TOKENS=600

# 段落打标签专用 API key。为空时会按 TAGGING_AI_PROVIDER 回退到对应主模型 key。
BOOK_ANALYZER_TAGGING_API_KEY=

# 段落打标签专用 base URL。接外部小模型、局域网模型服务或代理时填写。
BOOK_ANALYZER_TAGGING_BASE_URL=

# Embedding 提供方：local=本地 sentence-transformers；api=外部 OpenAI-compatible embedding API。
BOOK_ANALYZER_EMBEDDING_PROVIDER=local

# Embedding 向量维度。api 模式下按外部模型能力设置；local 默认模型固定为 384。
BOOK_ANALYZER_EMBEDDING_DIM=384

# 外部 embedding API 地址；EMBEDDING_PROVIDER=api 时必填。
BOOK_ANALYZER_EMBEDDING_API_URL=

# 外部 embedding API key；EMBEDDING_PROVIDER=api 时必填。
BOOK_ANALYZER_EMBEDDING_API_KEY=

# 外部 embedding 模型名；仅 EMBEDDING_PROVIDER=api 时使用。
BOOK_ANALYZER_EMBEDDING_API_MODEL=Qwen/Qwen3-VL-Embedding-8B

# 本地主 embedding 模型；EMBEDDING_PROVIDER=local 时优先加载。
BOOK_ANALYZER_LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# 本地备用 embedding 模型；主模型加载失败时尝试加载。
BOOK_ANALYZER_FALLBACK_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# 本地 embedding 模型缓存目录。相对路径会按 book-analyzer/ 根目录解析。
BOOK_ANALYZER_EMBEDDING_CACHE_DIR=embedding
